ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
EXA_API_KEY=            # not used in the MVP
VOICE_ID_FR=            # voice the parent hears
VOICE_ID_EN=            # voice the teacher hears
TRANSLATE_MODEL=        # optional; defaults to claude-haiku-5-5 (fastest, thinking off)
SUMMARY_MODEL=          # optional; defaults to claude-sonnet-5-5
DATABASE_URL=           # Render Postgres: External URL locally, Internal URL on the Render web service
SESSION_SECRET=         # long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_TEACHER_EMAIL=     # used only by scripts/seed_teacher.py, e.g. teacher@mapleridge.example
DEMO_TEACHER_PASSWORD=  # used only by scripts/seed_teacher.py; never commit it
DEMO_PARENT_EMAIL=      # used only by scripts/seed_teacher.py, e.g. parent@mapleridge.example
DEMO_PARENT_PASSWORD=   # used only by scripts/seed_teacher.py; never commit it
